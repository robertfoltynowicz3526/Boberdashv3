{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts --legacy-peer-deps",
  "buildCommand": "npm run build",
  "env": {
    "NODE_VERSION": "18",
    "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
    "NPM_CONFIG_STRICT_SSL": "true"
  }
}
